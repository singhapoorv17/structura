# Applies to `vercel deploy` from the CLI. Git deployments upload the whole
# repository, so the authoritative bundle filter for the Python functions is
# `functions["api/**/*.py"].excludeFiles` in vercel.json — keep the two in step.

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

node_modules/
.next/

tests/
samples/
requirements-dev.txt
Makefile
